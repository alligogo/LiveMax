#!/usr/bin/env bash
# LiveMax 호스트 명령 — get.sh 가 /usr/local/bin/livemax 로 설치한다.
#
#   livemax update      최신 이미지로 교체 (데이터는 /opt/livemax/data 에 그대로)
#   livemax rollback    직전 버전으로 되돌리기 (또는: livemax rollback <커밋 번호 40자리>)
#   livemax version     지금 버전(커밋 번호)과 되돌릴 수 있는 버전
#   livemax status      컨테이너 상태
#   livemax logs [-f]   관리 프로그램 로그
#   livemax restart     컨테이너 재시작 (모든 라이브가 순서대로 다시 시작)
#   livemax password    대시보드 관리자 비밀번호를 랜덤으로 재설정
#   livemax url         접속 주소
#   livemax tick        (타이머용) 웹의 업데이트 요청 처리 + 재부팅 필요 표시 동기화
set -euo pipefail
IMAGE="${LIVEMAX_IMAGE:-ghcr.io/alligogo/livemax:latest}"
REPO_IMG="${IMAGE%:*}"            # ghcr.io/alligogo/livemax — 빌드마다 :<커밋 번호> 태그도 올라간다
PREV_TAG="$REPO_IMG:previous"      # 업데이트 직전에 돌던 이미지 (되돌리기용 — 정리 대상에서 빠지게 태그로 붙잡아 둠)
REPO_GIT="${LIVEMAX_REPO:-https://github.com/alligogo/LiveMax.git}"
RAW="${LIVEMAX_RAW:-https://raw.githubusercontent.com/alligogo/LiveMax/main}"
DATA="${LIVEMAX_DATA_DIR:-/opt/livemax/data}"
NAME=livemax

need_root() { [[ $EUID -eq 0 ]] || { echo "root 권한이 필요합니다: sudo livemax $*"; exit 1; }; }

pull_image() {
  if docker pull "$IMAGE"; then return 0; fi
  echo "이미지를 받을 수 없어 소스에서 직접 빌드합니다 (5~10분)..."
  docker build -t "$IMAGE" "$REPO_GIT#main"
}

# 이 호스트 명령 자체도 최신으로 (실행 중인 파일은 mv 로 교체해야 안전 — 지금 실행은 옛 내용으로 끝까지 감)
self_update() {
  local me tmp
  me="$(readlink -f "$0")"
  tmp="$(mktemp "${me}.XXXX")" || return 0
  if curl -fsSL --max-time 20 "$RAW/host/livemax" -o "$tmp" && head -1 "$tmp" | grep -q '^#!/usr/bin/env bash' \
     && bash -n "$tmp"; then
    if ! cmp -s "$tmp" "$me"; then chmod 755 "$tmp"; mv -f "$tmp" "$me"; echo "호스트 명령(livemax)을 최신으로 바꿨습니다"; return 0; fi
  fi
  rm -f "$tmp"
}

run_container() {
  mkdir -p "$DATA"
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  docker run -d --name "$NAME" --restart unless-stopped --network host \
    --log-opt max-size=20m --log-opt max-file=3 \
    -v "$DATA:/data" \
    ${LIVEMAX_PUBLIC_IP:+-e LIVEMAX_PUBLIC_IP=$LIVEMAX_PUBLIC_IP} \
    "$IMAGE" >/dev/null
}

# 비상 스왑 (DESIGN 11-D 8): 메모리가 순간 꽉 차면 리눅스가 ffmpeg·관리 프로그램을 강제 종료(OOM)한다.
# 스왑이 하나도 없을 때만 /swapfile 2GB 를 만들고 평소엔 거의 안 쓰게(swappiness 10) 한다. 이미 스왑이 있으면 손대지 않음.
# 설치·업데이트·tick(30초) 때 확인 — 업데이트로 이 명령이 새로 바뀐 직후에도 다음 tick 에서 적용된다.
SWAP_MB="${LIVEMAX_SWAP_MB:-2048}"
ensure_swap() {
  [[ "$SWAP_MB" -gt 0 ]] || return 0
  [[ -n "$(swapon --noheadings --show 2>/dev/null)" ]] && return 0
  local f=/swapfile mark="$DATA/state/host/swap-unavailable" free_mb
  [[ -f "$mark" ]] && return 0          # 스왑을 못 쓰는 서버(일부 컨테이너형 VPS) — 매번 다시 시도하지 않음
  if [[ ! -f "$f" ]]; then
    free_mb="$(df -Pm / | awk 'NR==2 {print $4}')"
    if (( free_mb < SWAP_MB + 3072 )); then echo "디스크 여유가 부족해 비상 스왑을 만들지 않았습니다"; return 0; fi
    fallocate -l "${SWAP_MB}M" "$f" 2>/dev/null || dd if=/dev/zero of="$f" bs=1M count="$SWAP_MB" status=none || { rm -f "$f"; return 0; }
  fi
  chmod 600 "$f"
  if mkswap "$f" >/dev/null 2>&1 && swapon "$f" 2>/dev/null; then
    grep -qE '^/swapfile[[:space:]]' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    echo 'vm.swappiness=10' > /etc/sysctl.d/99-livemax-swap.conf
    sysctl -q -w vm.swappiness=10 || true
    echo "비상 스왑 ${SWAP_MB}MB 를 만들었습니다 (평소엔 거의 안 씀 — 메모리가 꽉 찰 때만)"
  else
    rm -f "$f"; mkdir -p "$(dirname "$mark")"; touch "$mark"
    echo "이 서버는 스왑을 쓸 수 없어 건너뜁니다"
  fi
}

# 지금 컨테이너의 버전(커밋 번호) — 이미지 안 LIVEMAX_VERSION
current_version() {
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NAME" 2>/dev/null | sed -n 's/^LIVEMAX_VERSION=//p' | head -1
}

# 업데이트 직전: 지금 돌던 이미지를 :previous 로 붙잡고 버전을 적어 둔다 (v2.17 — 되돌리기)
remember_previous() {
  local img ver
  img="$(docker inspect -f '{{.Image}}' "$NAME" 2>/dev/null)" || return 0
  [[ -n "$img" ]] || return 0
  docker tag "$img" "$PREV_TAG" 2>/dev/null || true
  ver="$(current_version)"
  mkdir -p "$DATA/state/host"
  [[ -n "$ver" ]] && echo "$ver" > "$DATA/state/host/previous_version"
  return 0
}

public_ip() { cat "$DATA/state/public_ip" 2>/dev/null || hostname -I | awk '{print $1}'; }

cmd="${1:-status}"
case "$cmd" in
  update|install)
    need_root "$cmd"
    [[ "$cmd" == update ]] && self_update
    ensure_swap || true
    [[ "$cmd" == update ]] && remember_previous
    pull_image
    run_container
    # 업데이트마다 이전 이미지(약 500MB)가 남는다 → 쓰지 않는 이미지 정리
    docker image prune -f >/dev/null 2>&1 || true
    echo "LiveMax 실행 중 — https://$(public_ip)"
    ;;
  rollback)
    # 새 버전에 문제가 있을 때: 직전 버전(또는 지정한 커밋 번호)으로 컨테이너만 바꿔 띄운다. 데이터는 그대로.
    # 다음 'livemax update' 를 하면 다시 최신으로 간다.
    need_root "$cmd"
    target="${2:-}"
    if [[ -n "$target" ]]; then
      [[ "$target" =~ ^[0-9a-f]{40}$ ]] || { echo "커밋 번호는 40자리 (livemax version 으로 확인)"; exit 1; }
      IMAGE="$REPO_IMG:$target"
      docker pull "$IMAGE" || { echo "그 버전 이미지를 받을 수 없습니다: $target"; exit 1; }
    elif docker image inspect "$PREV_TAG" >/dev/null 2>&1; then
      IMAGE="$PREV_TAG"
    elif [[ -s "$DATA/state/host/previous_version" ]]; then
      IMAGE="$REPO_IMG:$(cat "$DATA/state/host/previous_version")"
      docker pull "$IMAGE" || { echo "직전 버전 이미지를 받을 수 없습니다"; exit 1; }
    else
      echo "되돌릴 직전 버전 기록이 없습니다 — livemax rollback <커밋 번호 40자리>"; exit 1
    fi
    echo "$(date -u +%FT%TZ) 되돌리기: $(current_version) → $IMAGE" >> "$DATA/logs/update.log"
    run_container
    echo "되돌렸습니다 — $(current_version) (다시 최신으로: livemax update)"
    ;;
  version)
    echo "지금 버전: $(current_version)"
    [[ -s "$DATA/state/host/previous_version" ]] && echo "직전 버전: $(cat "$DATA/state/host/previous_version") (livemax rollback)"
    true
    ;;
  status)
    docker ps -a --filter "name=^${NAME}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
    ;;
  logs)
    shift || true
    docker logs --tail 200 "$@" "$NAME"
    ;;
  restart)
    need_root "$cmd"; docker restart "$NAME" >/dev/null; echo "재시작했습니다"
    ;;
  password)
    need_root "$cmd"
    docker exec "$NAME" python3 -m livemax.admin reset-password
    ;;
  url)
    echo "https://$(public_ip)"
    ;;
  tick)
    # 0) 비상 스왑 (없을 때만 한 번 만든다)
    ensure_swap >> "$DATA/logs/update.log" 2>&1 || true
    # 1) 서버 재부팅 필요 표시를 대시보드가 볼 수 있게 복사
    mkdir -p "$DATA/state/host"
    if [[ -f /var/run/reboot-required ]]; then
      cp -f /var/run/reboot-required "$DATA/state/host/reboot-required"
      cp -f /var/run/reboot-required.pkgs "$DATA/state/host/reboot-required.pkgs" 2>/dev/null || true
    else
      rm -f "$DATA/state/host/reboot-required" "$DATA/state/host/reboot-required.pkgs"
    fi
    # 2) 웹에서 '업데이트' 를 누르면 생기는 요청 파일 처리
    if [[ -f "$DATA/state/update.request" ]]; then
      rm -f "$DATA/state/update.request"
      echo "$(date -u +%FT%TZ) 웹 요청으로 업데이트" >> "$DATA/logs/update.log"
      "$0" update >> "$DATA/logs/update.log" 2>&1 || echo "업데이트 실패" >> "$DATA/logs/update.log"
    fi
    ;;
  *)
    sed -n '2,13p' "$0"; exit 1 ;;
esac
