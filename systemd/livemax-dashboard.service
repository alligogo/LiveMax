# 대시보드 (FastAPI). 127.0.0.1 에만 바인드 — 외부 HTTPS 는 Caddy 가 프록시
# 웹 업로드도 이 프로세스가 디스크에 쓰므로 I/O 우선순위를 낮춘다 (송출 읽기 보호)
[Unit]
Description=LiveMax dashboard
After=network-online.target

[Service]
Type=simple
User=livemax
Group=livemax
WorkingDirectory=@LIVEMAX_HOME@
Environment=LIVEMAX_HOME=@LIVEMAX_HOME@ PYTHONPATH=@LIVEMAX_HOME@/src PYTHONUNBUFFERED=1
ExecStart=@LIVEMAX_HOME@/venv/bin/python -m livemax.web.app
Restart=always
RestartSec=3
IOSchedulingClass=idle
Nice=5
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
