# 업로드 검증·이동 (_incoming → ffprobe → rename). 낮은 I/O 우선순위 = ionice -c3
[Unit]
Description=LiveMax upload ingest (ffprobe validation + atomic move)
After=local-fs.target

[Service]
Type=simple
User=livemax
Group=livemax
WorkingDirectory=@LIVEMAX_HOME@
Environment=LIVEMAX_HOME=@LIVEMAX_HOME@ PYTHONPATH=@LIVEMAX_HOME@/src PYTHONUNBUFFERED=1
ExecStart=@LIVEMAX_HOME@/venv/bin/python -m livemax.ingest
Restart=always
RestartSec=5
IOSchedulingClass=idle
Nice=15
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
