# 지표 수집 (10초 주기, /proc 읽기만) → SQLite
[Unit]
Description=LiveMax metrics collector
After=network-online.target

[Service]
Type=simple
User=livemax
Group=livemax
WorkingDirectory=@LIVEMAX_HOME@
Environment=LIVEMAX_HOME=@LIVEMAX_HOME@ PYTHONPATH=@LIVEMAX_HOME@/src PYTHONUNBUFFERED=1
ExecStart=@LIVEMAX_HOME@/venv/bin/python -m livemax.collector
Restart=always
RestartSec=5
Nice=10
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
